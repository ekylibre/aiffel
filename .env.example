# Copier en .env (jamais commité) et remplir.
# --- Application ---
AIFFEL_ENV=dev
AIFFEL_LOG_LEVEL=INFO
AIFFEL_PUBLIC_BASE_URL=http://localhost:8000
# Domaines Ekylibre acceptés au raccordement (JSON) ; le sous-domaine est le tenant de la ferme.
AIFFEL_EKYLIBRE_ALLOWED_DOMAINS=["ekylibre-dev.com","ekylibre.com"]
AIFFEL_PAIRING_CODE_TTL_MINUTES=15

# --- Moteur d'agent (A4) ---
AIFFEL_LLM_MODEL=claude-opus-5-5
AIFFEL_LLM_EFFORT=medium
AIFFEL_AGENT_MAX_ITERATIONS=8
AIFFEL_LEXICON_MCP_URL=https://lexicon.osfarm.org/mcp
AIFFEL_DATABASE_URL=postgresql+psycopg://aiffel_app:aiffel-app-dev@127.0.0.1:5442/aiffel
AIFFEL_MIGRATION_DATABASE_URL=postgresql+psycopg://aiffel:aiffel-dev@127.0.0.1:5442/aiffel

# --- Secrets (générer : python -c "import secrets; print(secrets.token_urlsafe(32))") ---
# Clé maître : AIFFEL_MASTER_KEY=1:<clé> (voir CLAUDE.md)
AIFFEL_MASTER_KEY=
AIFFEL_HASH_SALT=
AIFFEL_TELEGRAM_BOT_TOKEN=
AIFFEL_TELEGRAM_WEBHOOK_SECRET=
AIFFEL_ANTHROPIC_API_KEY=

# --- Accès infra (outils de l'équipe, pas lus par l'application) ---
# domain=
# GANDI_PAT=
# DOKPLOY_URL=
# DOKPLOY_API_KEY=
# SSH_ACCES_LOCAL=
