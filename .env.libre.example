# Installation libre d'Aiffel (BYO strict). Copier en `.env` à côté de ce fichier puis compléter.
# Sans support ; voir docs/ops/install-libre.md pour la procédure et les mises en garde.

# --- URL publique (HTTPS) où Telegram atteint le webhook ---
AIFFEL_PUBLIC_BASE_URL=https://aiffel.example.com

# --- Base de données ---
# Mot de passe du propriétaire du schéma (migrations) et du rôle applicatif (soumis à la RLS).
# Différents en production ; libre à vous ici.
POSTGRES_PASSWORD=changez-moi
AIFFEL_APP_PASSWORD=changez-moi-aussi

# --- Secrets (générer : python -c "import secrets; print(secrets.token_urlsafe(32))") ---
# Clé maître : format AIFFEL_MASTER_KEY=1:<clé> (voir CLAUDE.md § Base de données).
#   uv run python -c "from aiffel.vault import generate_key; print(generate_key())"
AIFFEL_MASTER_KEY=
AIFFEL_HASH_SALT=

# --- Telegram ---
# Créez un bot avec @BotFather ; le token a la forme 1234567890:ABCDEF...
AIFFEL_TELEGRAM_BOT_TOKEN=
# Clé partagée avec Telegram pour vérifier l'en-tête X-Telegram-Bot-Api-Secret-Token.
AIFFEL_TELEGRAM_WEBHOOK_SECRET=

# --- Clés LLM (BYO : au moins une est requise selon le fournisseur choisi) ---
# Anthropic (recommandé) : https://console.anthropic.com/
AIFFEL_ANTHROPIC_API_KEY=
# OpenRouter (optionnel) : https://openrouter.ai/
AIFFEL_OPENROUTER_API_KEY=
# Fournisseur et modèle par défaut ; les fermes peuvent choisir via /modele.
AIFFEL_LLM_PROVIDER=anthropic
AIFFEL_LLM_MODEL=claude-opus-5-5
AIFFEL_LLM_EFFORT=medium

# --- Pl@ntNet (optionnel : identification maladies/espèces depuis les photos) ---
# https://my.plantnet.org/
AIFFEL_PLANTNET_API_KEY=

# --- Vocal (faster-whisper, local) ---
AIFFEL_STT_ENABLED=true

# --- Exposition HTTP (reverse-proxy en front recommandé) ---
# Par défaut, l'app écoute sur 127.0.0.1:8000 : à mettre en 0.0.0.0 si votre proxy est externe
# à l'hôte, ou à conserver si Caddy/Traefik/Nginx tournent sur la même machine.
AIFFEL_HTTP_BIND=127.0.0.1
AIFFEL_HTTP_PORT=8000
